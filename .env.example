# ==========================================
# ScamSignal Environment Configuration
# ==========================================
# Copy this file to .env.local for local testing:
# cp .env.example .env.local

# AI Provider Configuration (Choose one or both)
# Option 1: Google Gemini (Recommended)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI or compatible API (Alternative)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Optional custom base URL for OpenAI-compatible providers (Groq, OpenRouter, Ollama, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred AI Provider (Optional: "gemini" or "openai"; defaults to whichever key is provided)
AI_PROVIDER=gemini

# Demo Mode (Optional: set to "true" to force local sample analysis even if keys are present)
DEMO_MODE=false

# Rate Limiting Configuration (Per IP window)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Public App URL (Used for OpenGraph metadata and sitemap generation)
NEXT_PUBLIC_APP_URL=https://scamsignal.vercel.app
